# SQLite for the MVP. For PostgreSQL change the provider in prisma/schema.prisma and use a postgres:// URL.
DATABASE_URL="file:./dev.db"
PORT=4000
# 32-byte key (64 hex chars) used for AES-256-GCM encryption of vault files at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_ENCRYPTION_KEY=
STORAGE_DIR=./storage
# Comma-separated extra CORS origins (chrome-extension:// origins are always allowed).
CORS_ORIGINS=http://localhost:5173
# ── AI provider (optional). Without it the app uses deterministic rule-based extraction and templates.
AI_PROVIDER=none            # none | anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# ── Discovery via a search API (optional). Without it, discovery uses your seed pages/feeds.
SEARCH_PROVIDER=none        # none | brave
BRAVE_API_KEY=
# ── Crawler
CRAWLER_USER_AGENT="PhDApplicationAssistant/0.1 (+personal research tool; respects robots.txt)"
CRAWLER_MIN_DELAY_MS=2000
# ── Background jobs
SCHEDULER_ENABLED=true
REVERIFY_INTERVAL_HOURS=24
NOTIFY_INTERVAL_MINUTES=60
# ── Optional email notifications (to yourself only). Supervisor emails are never sent by the app.
SMTP_URL=
SMTP_FROM=
